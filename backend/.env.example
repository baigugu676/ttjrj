# 后端服务环境变量模板：复制为 .env 后按实际环境填写

# 服务端口
PORT=3000

# MySQL 数据库连接
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=repair_system

# 连接池（可选，默认 10）
# DB_POOL_LIMIT=10
# DB_POOL_MAX_IDLE=10
# DB_POOL_IDLE_TIMEOUT=60000

# JWT 密钥：必须为 32 位以上随机字符串，生成方式：openssl rand -hex 32
# 弱密钥会导致 token 可被伪造，服务启动时会校验长度并拒绝启动
JWT_SECRET=

# 图片上传目录（相对 backend/src，默认 uploads）
# UPLOAD_DIR=uploads

# CORS 白名单（逗号分隔的完整 Origin，如 https://admin.example.com）；
# 未配置时放开所有来源，生产部署 Web 管理后台时建议配置
# CORS_ORIGINS=
