/* 点位管理页样式 */
.list {
  padding: 24rpx;
}
.loc-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.loc-info {
  flex: 1;
  min-width: 0;
}
.loc-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.loc-sub {
  font-size: 24rpx;
  color: #999999;
  margin-top: 8rpx;
}
.loc-ops {
  display: flex;
  flex-shrink: 0;
}
.op-btn {
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  margin-left: 12rpx;
}
.op-btn.edit {
  background: #F2F3F5;
  color: #666666;
}
.op-btn.delete {
  background: rgba(250, 81, 81, 0.1);
  color: #FA5151;
}

/* 悬浮添加按钮 */
.fab {
  position: fixed;
  right: 32rpx;
  bottom: 80rpx;
  background: #07C160;
  color: #FFFFFF;
  font-size: 28rpx;
  padding: 24rpx 36rpx;
  border-radius: 44rpx;
  box-shadow: 0 8rpx 24rpx rgba(7, 193, 96, 0.4);
  z-index: 20;
}

/* 弹窗 */
.mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 90;
}
.modal {
  position: fixed;
  left: 60rpx;
  right: 60rpx;
  top: 50%;
  transform: translateY(-50%);
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 40rpx 32rpx;
  z-index: 100;
}
.modal-title {
  font-size: 34rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 32rpx;
}
.modal-btns {
  display: flex;
  margin-top: 16rpx;
}
.modal-btn {
  flex: 1;
}
.modal-btn:first-child {
  margin-right: 20rpx;
}
