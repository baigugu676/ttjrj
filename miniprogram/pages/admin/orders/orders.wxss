/* 工单管理页样式 */
.search-bar {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx 0;
}
.search-input {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  background: #FFFFFF;
  border: 1rpx solid #E5E5E5;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 26rpx;
}
.search-btn {
  width: 120rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  background: #07C160;
  color: #FFFFFF;
  border-radius: 12rpx;
  font-size: 26rpx;
  margin-left: 16rpx;
}
.filter-tabs {
  display: flex;
  background: #FFFFFF;
  padding: 20rpx 8rpx;
  margin-top: 20rpx;
}
.filter-tab {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: #666666;
  padding: 10rpx 0;
  border-radius: 30rpx;
  margin: 0 4rpx;
}
.filter-tab.active {
  background: rgba(7, 193, 96, 0.12);
  color: #07C160;
  font-weight: 600;
}
.list {
  padding: 20rpx 24rpx 40rpx;
}
.row {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.row-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}
.row-location {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  max-width: 65%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.row-line {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.6;
}
.row-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
}
.row-time {
  font-size: 24rpx;
  color: #999999;
}
/* 操作按钮 */
.op-btn {
  padding: 8rpx 32rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
}
.btn-approve {
  background: #07C160;
  color: #FFFFFF;
}
.btn-verify {
  background: #8A6FF8;
  color: #FFFFFF;
}
.btn-view {
  background: #F2F3F5;
  color: #666666;
}
.load-more {
  text-align: center;
  font-size: 24rpx;
  color: #999999;
  padding: 20rpx 0;
}

/* 首页返回条（本页无 tabBar，提供导航出口与导出入口） */
.home-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 24rpx 0;
}
.home-btn {
  font-size: 26rpx;
  color: #1677FF;
  padding: 8rpx 20rpx;
  background: #E8F2FF;
  border-radius: 24rpx;
}
.export-btn {
  font-size: 26rpx;
  color: #07C160;
  padding: 8rpx 20rpx;
  background: #E8F9EF;
  border-radius: 24rpx;
}
