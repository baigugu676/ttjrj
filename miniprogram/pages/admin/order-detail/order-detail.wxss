/* 工单详情（管理员）样式 */
.head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.order-no {
  font-size: 24rpx;
  color: #999999;
}
.info-row {
  display: flex;
  margin-bottom: 16rpx;
  line-height: 1.6;
}
.info-row .label {
  width: 140rpx;
  flex-shrink: 0;
  color: #999999;
  font-size: 26rpx;
}
.info-row .value {
  flex: 1;
  font-size: 26rpx;
  color: #333333;
  word-break: break-all;
}
.photo-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 8rpx;
}
.photo {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  margin: 0 16rpx 16rpx 0;
}

/* 维修前后并排对比 */
.compare {
  display: flex;
}
.compare-col {
  flex: 1;
  min-width: 0;
}
.compare-col:first-child {
  margin-right: 20rpx;
}
.compare-label {
  text-align: center;
  font-size: 26rpx;
  font-weight: 600;
  padding: 8rpx 0;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
}
.compare-label.before {
  background: rgba(16, 174, 255, 0.12);
  color: #10AEFF;
}
.compare-label.after {
  background: rgba(7, 193, 96, 0.12);
  color: #07C160;
}
.mini-grid {
  display: flex;
  flex-wrap: wrap;
}
.mini-photo {
  width: 150rpx;
  height: 150rpx;
  border-radius: 12rpx;
  margin: 0 12rpx 12rpx 0;
}
.empty-mini {
  width: 100%;
  text-align: center;
  color: #CCCCCC;
  font-size: 24rpx;
  padding: 40rpx 0;
}

/* 操作区 */
.op-area {
  border-left: 6rpx solid #07C160;
}
.op-btns {
  display: flex;
}
.op-btn-lg {
  flex: 1;
  height: 96rpx;
  line-height: 96rpx;
  font-size: 34rpx;
}
.op-btn-lg:first-child {
  margin-right: 20rpx;
}
