/* 首页样式 */
.hero {
  background: linear-gradient(135deg, #07C160, #10D16F);
  padding: 48rpx 32rpx 64rpx;
  border-radius: 0 0 32rpx 32rpx;
}
.hero-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #FFFFFF;
}
.hero-sub {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 12rpx;
}
.new-btn {
  margin-top: 40rpx;
  width: 60%;
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.12);
}

/* 统计卡片 */
.stats {
  display: flex;
  margin: -36rpx 24rpx 0;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 28rpx 8rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  position: relative;
  z-index: 1;
}
.stat-item {
  flex: 1;
  text-align: center;
}
.num {
  font-size: 44rpx;
  font-weight: 600;
  color: #07C160;
}
.label {
  font-size: 24rpx;
  color: #999999;
  margin-top: 8rpx;
}

/* 区块 */
.section {
  margin: 32rpx 24rpx 0;
}
.monitor-overview-entry{display:flex;align-items:center;justify-content:space-between;margin:32rpx 24rpx 48rpx;padding:28rpx 24rpx;background:#fff;border-radius:16rpx;box-shadow:0 2rpx 12rpx rgba(0,0,0,.04);color:#07c160;font-size:28rpx}.monitor-overview-arrow{font-size:36rpx;line-height:1;color:#999}

/* 维修人员快捷入口 */
.quick-row {
  display: flex;
  margin: 32rpx 24rpx 0;
}
.quick-item {
  flex: 1;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 32rpx 24rpx;
  margin-right: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  position: relative;
}
.quick-item:last-child {
  margin-right: 0;
}
.quick-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
}
.badge {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  min-width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  padding: 0 10rpx;
  background: #FA5151;
  color: #FFFFFF;
  font-size: 22rpx;
  border-radius: 20rpx;
  box-sizing: border-box;
}

/* 管理员快捷入口网格 */
.quick-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 32rpx 24rpx 0;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx 8rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.quick-cell {
  width: 33.33%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0;
  box-sizing: border-box;
}
.quick-icon {
  font-size: 48rpx;
}
.quick-label {
  font-size: 24rpx;
  color: #666666;
  margin-top: 12rpx;
}

/* 管理员首页 —— 监控状态概览卡片 */
.home-monitor-card {
  display: flex;
  align-items: center;
  margin: 24rpx 24rpx 0;
  padding: 24rpx 28rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,.04);
}
.hmc-left {
  flex: 1;
  min-width: 0;
  padding-right: 16rpx;
}
.hmc-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 12rpx;
}
.hmc-stats {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 8rpx;
}
.hmc-stat {
  font-size: 22rpx;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  color: #fff;
}
.hmc-stat.normal {
  background: #16a34a;
}
.hmc-stat.fault {
  background: #ef4444;
}
.hmc-stat.repairing {
  background: #f59e0b;
}
.hmc-total {
  font-size: 23rpx;
  color: #999;
}
.hmc-rate-summary {
  color: #64748b;
  font-size: 22rpx;
  margin-bottom: 6rpx;
}
.hmc-rate-summary text {
  color: #16a34a;
  font-size: 30rpx;
  font-weight: 600;
}
.hmc-more {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #07c160;
}
.hmc-right {
  flex: 0 0 160rpx;
  width: 160rpx;
  height: 160rpx;
  margin: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}
.hmc-canvas {
  width: 160rpx;
  height: 160rpx;
}
