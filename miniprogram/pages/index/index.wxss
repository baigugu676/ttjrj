/* 首页样式 */
.hero {
  background: linear-gradient(135deg, #07C160, #10D16F);
  padding: 48rpx 32rpx 64rpx;
  border-radius: 0 0 32rpx 32rpx;
}
.hero-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #FFFFFF;
}
.hero-sub {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 12rpx;
}
.new-btn {
  margin-top: 40rpx;
  width: 60%;
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.12);
}

/* 统计卡片 */
.stats {
  display: flex;
  margin: -36rpx 24rpx 0;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 28rpx 8rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  position: relative;
  z-index: 1;
}
.stat-item {
  flex: 1;
  text-align: center;
}
.num {
  font-size: 44rpx;
  font-weight: 600;
  color: #07C160;
}
.label {
  font-size: 24rpx;
  color: #999999;
  margin-top: 8rpx;
}

/* 区块 */
.section {
  margin: 32rpx 24rpx 0;
}

/* 维修人员快捷入口 */
.quick-row {
  display: flex;
  margin: 32rpx 24rpx 0;
}
.quick-item {
  flex: 1;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 32rpx 24rpx;
  margin-right: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  position: relative;
}
.quick-item:last-child {
  margin-right: 0;
}
.quick-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
}
.badge {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  min-width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  padding: 0 10rpx;
  background: #FA5151;
  color: #FFFFFF;
  font-size: 22rpx;
  border-radius: 20rpx;
  box-sizing: border-box;
}

/* 管理员快捷入口网格 */
.quick-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 32rpx 24rpx 0;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx 8rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.quick-cell {
  width: 33.33%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0;
  box-sizing: border-box;
}
.quick-icon {
  font-size: 48rpx;
}
.quick-label {
  font-size: 24rpx;
  color: #666666;
  margin-top: 12rpx;
}
