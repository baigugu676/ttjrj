<!-- 维修执行页（核心页面）：报修信息 → 维修前拍照 → 维修时间 → GPS定位 → 故障原因 → 维修措施 → 维修后拍照 → OK上线 -->
<view class="page" wx:if="{{order}}">

  <!-- 报修信息区 -->
  <view class="card">
    <view class="card-title">报修信息</view>
    <view class="info-row">
      <text class="label">工单号</text>
      <text class="value">{{order.order_no}}</text>
    </view>
    <view class="info-row">
      <text class="label">点位</text>
      <text class="value">{{order.location_name || '未知点位'}}</text>
    </view>
    <view class="info-row">
      <text class="label">故障描述</text>
      <text class="value">{{order.fault_description}}</text>
    </view>
    <view class="info-row" wx:if="{{order.fault_cause}}">
      <text class="label">故障原因</text>
      <text class="value">{{order.fault_cause}}</text>
    </view>
    <view class="info-row" wx:if="{{order.repair_requirements}}">
      <text class="label">维修要求</text>
      <text class="value">{{order.repair_requirements}}</text>
    </view>
    <view class="photo-row" wx:if="{{reportImages.length}}">
      <image class="photo" wx:for="{{reportImages}}" wx:key="*this" src="{{item}}" mode="aspectFill"
        bindtap="previewReport" data-index="{{index}}"></image>
    </view>
  </view>

  <!-- 步骤1：维修前拍照 -->
  <view class="card step-card">
    <view class="step-head">
      <text class="step-no">1</text>
      <text class="step-title">维修前拍照</text>
      <text class="form-required">* 至少1张</text>
    </view>
    <view class="upload-grid">
      <view class="upload-item" wx:for="{{beforeImages}}" wx:key="*this">
        <image class="upload-img" src="{{item}}" mode="aspectFill"
          bindtap="previewLocal" data-key="beforeImages" data-index="{{index}}"></image>
        <view class="upload-del" catchtap="deletePhoto" data-key="beforeImages" data-index="{{index}}">✕</view>
      </view>
      <view class="upload-add" wx:if="{{beforeImages.length < 9}}" bindtap="takePhoto" data-type="before">
        <text class="plus">＋</text>
        <text class="add-text">拍照</text>
      </view>
    </view>
  </view>

  <!-- 步骤2：维修时间 -->
  <view class="card step-card">
    <view class="step-head">
      <text class="step-no">2</text>
      <text class="step-title">维修时间</text>
      <text class="form-required">*</text>
    </view>
    <view class="time-row">
      <picker mode="date" value="{{repairDate}}" bindchange="onDateChange">
        <view class="time-picker">{{repairDate}} ▾</view>
      </picker>
      <picker mode="time" value="{{repairTime}}" bindchange="onTimeChange">
        <view class="time-picker">{{repairTime}} ▾</view>
      </picker>
    </view>
  </view>

  <!-- 步骤3：维修地点（GPS定位） -->
  <view class="card step-card">
    <view class="step-head">
      <text class="step-no">3</text>
      <text class="step-title">维修地点</text>
      <text class="form-required">*</text>
    </view>
    <view class="loc-box">
      <view class="loc-coords" wx:if="{{gpsText}}">{{gpsText}}</view>
      <view class="loc-coords placeholder" wx:else>{{locating ? '正在定位...' : '尚未获取位置，请点击下方按钮定位'}}</view>
      <button class="btn btn-default loc-btn" bindtap="getLocation" disabled="{{locating}}">
        {{locating ? '定位中...' : '📍 GPS定位'}}
      </button>
      <view class="form-label address-label">地址描述</view>
      <input class="form-input" placeholder="填写现场地址描述（如：XX市XX路XX号3楼）" maxlength="200"
        value="{{locationAddress}}" bindinput="onAddressInput" />
    </view>
  </view>

  <!-- 步骤4：故障原因 -->
  <view class="card step-card">
    <view class="step-head">
      <text class="step-no">4</text>
      <text class="step-title">故障原因</text>
      <text class="form-required">* 必填</text>
    </view>
    <textarea class="form-textarea" placeholder="请分析并描述造成故障的原因..." maxlength="500"
      value="{{faultReason}}" bindinput="onReasonInput"></textarea>
  </view>

  <!-- 步骤5：维修措施 -->
  <view class="card step-card">
    <view class="step-head">
      <text class="step-no">5</text>
      <text class="step-title">维修措施</text>
      <text class="form-required">* 必填</text>
    </view>
    <textarea class="form-textarea" placeholder="请描述您具体做了什么维修操作..." maxlength="500"
      value="{{repairAction}}" bindinput="onActionInput"></textarea>
  </view>

  <!-- 步骤6：维修后拍照 -->
  <view class="card step-card">
    <view class="step-head">
      <text class="step-no">6</text>
      <text class="step-title">维修后拍照</text>
      <text class="form-required">* 至少1张</text>
    </view>
    <view class="upload-grid">
      <view class="upload-item" wx:for="{{afterImages}}" wx:key="*this">
        <image class="upload-img" src="{{item}}" mode="aspectFill"
          bindtap="previewLocal" data-key="afterImages" data-index="{{index}}"></image>
        <view class="upload-del" catchtap="deletePhoto" data-key="afterImages" data-index="{{index}}">✕</view>
      </view>
      <view class="upload-add" wx:if="{{afterImages.length < 9}}" bindtap="takePhoto" data-type="after">
        <text class="plus">＋</text>
        <text class="add-text">拍照</text>
      </view>
    </view>
  </view>

  <!-- OK上线 / 挂起 -->
  <!-- OK上线 / 挂起：仅维修中或返修退回状态可操作 -->
  <view class="ok-area" wx:if="{{order.status === 'repairing' || order.status === 'repair_returned'}}">
    <view class="upload-progress" wx:if="{{uploadProgress}}">{{uploadProgress}}</view>
    <view class="ok-btns">
      <button wx:if="{{order.status === 'repairing'}}" class="btn btn-suspend" bindtap="onSuspend"
        loading="{{suspending}}" disabled="{{submitting || suspending}}">⏸️ 挂起</button>
      <button class="btn btn-ok" bindtap="onSubmit" loading="{{submitting}}" disabled="{{suspending || submitting}}">✅ 确认OK上线</button>
    </view>
  </view>
  <view class="ok-area" wx:else>
    <view class="status-tip">当前工单状态：{{statusText}}，请先返回任务列表进行恢复/查看</view>
  </view>

  <!-- 自绘确认弹窗（不用 wx.showModal，避免系统弹窗冲突导致提交无法开始） -->
  <view class="confirm-mask" wx:if="{{showConfirm}}" catchtap="onConfirmCancel">
    <view class="confirm-dialog" catchtap="noop">
      <view class="confirm-title">确认OK上线</view>
      <view class="confirm-content">确认设备已修复完成并上线？</view>
      <view class="confirm-btns">
        <button class="confirm-btn confirm-cancel" catchtap="onConfirmCancel">取消</button>
        <button class="confirm-btn confirm-ok" catchtap="onConfirmOk">确认OK上线</button>
      </view>
    </view>
  </view>
</view>

<view class="empty" wx:elif="{{loadError}}">
  <text>工单加载失败，请检查网络</text>
  <button class="btn btn-default" bindtap="loadOrder">重新加载</button>
</view>

<view class="empty" wx:else>加载中...</view>
