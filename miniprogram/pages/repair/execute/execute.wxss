/* 维修执行页样式（核心页面） */
.info-row {
  display: flex;
  margin-bottom: 16rpx;
  line-height: 1.6;
}
.info-row .label {
  width: 140rpx;
  flex-shrink: 0;
  color: #999999;
  font-size: 26rpx;
}
.info-row .value {
  flex: 1;
  font-size: 26rpx;
  color: #333333;
  word-break: break-all;
}
.photo-row {
  display: flex;
  flex-wrap: wrap;
  margin-top: 8rpx;
}
.photo {
  width: 150rpx;
  height: 150rpx;
  border-radius: 12rpx;
  margin: 0 12rpx 12rpx 0;
}

/* 步骤卡片 */
.step-card {
  border-left: 6rpx solid #07C160;
}
.step-head {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}
.step-no {
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  background: #07C160;
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 600;
  border-radius: 50%;
  margin-right: 14rpx;
}
.step-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  flex: 1;
}
.step-head .form-required {
  font-size: 22rpx;
  font-weight: 400;
}

/* 维修时间 */
.time-row {
  display: flex;
}
.time-picker {
  width: 240rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  background: #FAFAFA;
  border: 1rpx solid #E5E5E5;
  border-radius: 12rpx;
  font-size: 30rpx;
  color: #333333;
  margin-right: 20rpx;
}

/* 维修地点 */
.loc-coords {
  font-size: 26rpx;
  color: #07C160;
  font-weight: 500;
  margin-bottom: 16rpx;
  word-break: break-all;
}
.loc-coords.placeholder {
  color: #999999;
  font-weight: 400;
}
.loc-btn {
  height: 76rpx;
  line-height: 76rpx;
  font-size: 28rpx;
  margin-bottom: 24rpx;
}
.address-label {
  margin-bottom: 10rpx;
}

/* OK上线大按钮 */
.ok-area {
  padding: 40rpx 48rpx 60rpx;
}
.status-tip {
  text-align: center;
  font-size: 28rpx;
  color: #999999;
  padding: 40rpx 0;
}
.ok-btns {
  display: flex;
  align-items: stretch;
}
.btn-suspend {
  flex: 0 0 220rpx;
  height: 116rpx;
  line-height: 116rpx;
  border-radius: 20rpx;
  background: #FFFFFF;
  color: #666666;
  border: 2rpx solid #E5E5E5;
  font-size: 30rpx;
  padding: 0;
  margin: 0 20rpx 0 0;
  box-sizing: border-box;
  box-shadow: none;
}
.ok-btns .btn-ok {
  flex: 1;
  width: auto;
}

/* 照片上传进度提示 */
.upload-progress {
  text-align: center;
  font-size: 26rpx;
  color: #07C160;
  margin-bottom: 16rpx;
}

/* 自绘确认弹窗 */
.confirm-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}
.confirm-dialog {
  width: 560rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  overflow: hidden;
}
.confirm-title {
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
  color: #333333;
  padding: 40rpx 32rpx 12rpx;
}
.confirm-content {
  text-align: center;
  font-size: 28rpx;
  color: #666666;
  padding: 0 32rpx 36rpx;
}
.confirm-btns {
  display: flex;
  border-top: 1rpx solid #EEEEEE;
}
.confirm-btn {
  flex: 1;
  height: 96rpx;
  line-height: 96rpx;
  font-size: 30rpx;
  border-radius: 0;
  background: #FFFFFF;
  padding: 0;
  margin: 0;
}
.confirm-btn::after {
  border: none;
}
.confirm-cancel {
  color: #999999;
  border-right: 1rpx solid #EEEEEE;
}
.confirm-ok {
  color: #07C160;
  font-weight: 600;
}
