/* 待维修工单池样式 */
.list {
  padding: 24rpx;
}
.pool-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.pool-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.status-tag {
  width: 56rpx;
  height: 56rpx;
  border-radius: 999rpx;
  line-height: 56rpx;
  font-size: 30rpx;
  text-align: center;
  color: #FFFFFF;
  font-weight: 500;
}
.status-tag.pending_repair {
  background: #1677FF;
}
.status-tag.repair_returned {
  background: #FA5151;
}
/* 退回工单卡片：红色左边框 + 淡红底色 */
.pool-card.repair_returned {
  border-left: 8rpx solid #FA5151;
  background: #FFF5F5;
}
.pool-location {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
}
.status-subtext {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #999999;
}
.pool-desc {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.5;
  margin: 16rpx 0;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
.pool-info {
  display: flex;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
.pool-no {
  font-size: 24rpx;
  color: #BBBBBB;
}
.pool-time {
  font-size: 24rpx;
  color: #999999;
}
.pool-ops {
  display: flex;
}
.accept-btn {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  font-size: 30rpx;
}
.transfer-btn {
  width: 180rpx;
  height: 76rpx;
  line-height: 76rpx;
  font-size: 28rpx;
  margin-left: 16rpx;
  padding: 0;
  background: #FFFFFF;
  color: #1677FF;
  border: 1rpx solid #1677FF;
  border-radius: 44rpx;
}
.btn-view {
  background: #FFFFFF;
  color: #1677FF;
  border: 1rpx solid #1677FF;
}

/* 转交弹窗 */
.mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 90;
}
.modal {
  position: fixed;
  left: 60rpx;
  right: 60rpx;
  top: 50%;
  transform: translateY(-50%);
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 40rpx 32rpx;
  z-index: 100;
}
.modal-title {
  font-size: 34rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 32rpx;
}
.modal-btns {
  display: flex;
  margin-top: 16rpx;
}
.modal-btn {
  flex: 1;
}
.modal-btn:first-child {
  margin-right: 20rpx;
}
.load-more {
  text-align: center;
  font-size: 24rpx;
  color: #999999;
  padding: 20rpx 0;
}
