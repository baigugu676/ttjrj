<!-- 我的维修任务：维修中 / 待验收 / 已完成 -->
<view class="page">
  <!-- 本页由「工单」tab 进入（tabBar 不可见），提供首页入口避免导航死胡同 -->
  <view class="home-bar">
    <view class="home-btn" bindtap="goHome">🏠 返回首页</view>
  </view>

  <view class="tabs">
    <view class="tab {{tab === item.value ? 'active' : ''}}"
      wx:for="{{tabs}}" wx:key="value" bindtap="onTabChange" data-value="{{item.value}}">
      {{item.label}}
    </view>
  </view>

  <view class="list">
    <view class="task-item" wx:for="{{list}}" wx:key="id">
      <order-card order="{{item}}" bind:tap="goDetail" />
      <button class="btn btn-primary enter-btn" wx:if="{{tab === 'repairing' || tab === 'repair_returned'}}" bindtap="goExecute" data-id="{{item.id}}">
        进入维修
      </button>
      <button class="btn btn-view enter-btn" wx:elif="{{tab === 'today_completed' || tab === 'completed'}}" bindtap="goDetailById" data-id="{{item.id}}">
        查看详情
      </button>
    </view>
    <view class="empty" wx:if="{{!list.length && !loading}}">暂无相关工单</view>
    <view class="load-more" wx:if="{{list.length}}">{{hasMore ? '上拉加载更多...' : '没有更多了'}}</view>
  </view>
</view>
