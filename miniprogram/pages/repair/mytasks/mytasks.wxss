/* 我的维修任务页样式 */
.tabs {
  display: flex;
  background: #FFFFFF;
  padding: 20rpx 8rpx;
  position: sticky;
  top: 0;
  z-index: 10;
}
.tab {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: #666666;
  padding: 10rpx 0;
  border-radius: 30rpx;
  margin: 0 6rpx;
}
.tab.active {
  background: rgba(7, 193, 96, 0.12);
  color: #07C160;
  font-weight: 600;
}
.list {
  padding: 24rpx;
}
.task-item {
  position: relative;
}
.enter-btn {
  height: 72rpx;
  line-height: 72rpx;
  font-size: 28rpx;
  margin: -8rpx 0 24rpx;
}
/* 任务操作按钮组 */
.task-ops {
  display: flex;
  flex-wrap: wrap;
  margin: -8rpx 0 24rpx;
}
.op-btn-sm {
  height: 64rpx;
  line-height: 64rpx;
  font-size: 26rpx;
  padding: 0 28rpx;
  border-radius: 32rpx;
  margin-right: 16rpx;
  margin-bottom: 12rpx;
}
.btn-warn {
  background: #FFFFFF;
  color: #FF9500;
  border: 1rpx solid #FF9500;
}
.load-more {
  text-align: center;
  font-size: 24rpx;
  color: #999999;
  padding: 20rpx 0;
}

/* 首页返回条（本页无 tabBar，提供导航出口） */
.home-bar {
  display: flex;
  justify-content: flex-end;
  padding: 16rpx 24rpx 0;
}
.home-btn {
  font-size: 26rpx;
  color: #1677FF;
  padding: 8rpx 20rpx;
  background: #E8F2FF;
  border-radius: 24rpx;
}

/* 「查看详情」按钮样式（原定义在 admin/orders 页，此处补齐） */
.btn-view {
  background: #FFFFFF;
  color: #1677FF;
  border: 1rpx solid #1677FF;
}

/* 转交弹窗 */
.mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 90;
}
.modal {
  position: fixed;
  left: 60rpx;
  right: 60rpx;
  top: 50%;
  transform: translateY(-50%);
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 40rpx 32rpx;
  z-index: 100;
}
.modal-title {
  font-size: 34rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 32rpx;
}
.modal-btns {
  display: flex;
  margin-top: 16rpx;
}
.modal-btn {
  flex: 1;
}
.modal-btn:first-child {
  margin-right: 20rpx;
}
