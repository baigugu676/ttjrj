.page{padding:24rpx;background:#f5f7f8;min-height:100vh;box-sizing:border-box}.state{text-align:center;padding:120rpx 24rpx;color:#999;font-size:28rpx}.error{color:#d14343}.retry{color:#07c160}.hero,.section,.metrics,.recent{background:#fff;border-radius:12rpx}.hero{padding:30rpx 28rpx;position:relative}.title{font-size:38rpx;font-weight:600;color:#222}.sub{font-size:25rpx;color:#888;margin-top:10rpx}.status{position:absolute;right:28rpx;top:34rpx;font-size:30rpx;font-weight:600}.metrics{display:flex;justify-content:space-around;padding:26rpx 10rpx;margin-top:18rpx}.metrics view{text-align:center;flex:1;border-right:1rpx solid #eee}.metrics view:last-child{border:0}.metrics text{display:block;font-size:34rpx;font-weight:600;color:#222}.metrics label{display:block;color:#888;font-size:22rpx;margin-top:8rpx}.recent{padding:18rpx 24rpx;color:#666;font-size:24rpx;margin-top:18rpx}.section{padding:24rpx;margin-top:18rpx}.section-title{font-size:30rpx;font-weight:600;color:#222;margin-bottom:18rpx}.empty{text-align:center;color:#aaa;padding:30rpx 0}.order{padding:18rpx 0;border-bottom:1rpx solid #f0f0f0}.order:last-child{border:0}.order-no{font-size:28rpx;color:#333;font-weight:600}.order-status{font-size:22rpx;color:#888;margin-left:16rpx}.order-meta,.order-time{font-size:23rpx;color:#777;margin-top:8rpx}.event{display:flex;position:relative;padding-bottom:26rpx}.event:last-child{padding-bottom:0}.dot{width:16rpx;height:16rpx;background:#07c160;border-radius:50%;margin:8rpx 18rpx 0 2rpx;flex:none}.event-body{flex:1;border-bottom:1rpx solid #f0f0f0;padding-bottom:18rpx}.event:last-child .event-body{border:0}.event-head{display:flex;justify-content:space-between;font-size:27rpx;color:#333}.event-time{font-size:22rpx;color:#999}.actor{font-size:23rpx;color:#555;margin-top:8rpx}.desc{font-size:25rpx;color:#777;line-height:1.5;margin-top:8rpx}
