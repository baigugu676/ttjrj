.page{min-height:100vh;padding:24rpx;background:#f5f7f8;box-sizing:border-box}.state{text-align:center;padding:120rpx 24rpx;color:#999;font-size:28rpx}.error{color:#d14343}.retry{color:#07c160}.chart-card,.table-entry{background:#fff;border-radius:12rpx;box-shadow:0 2rpx 12rpx rgba(0,0,0,.04)}.chart-card{padding:24rpx}.chart-head{display:flex;justify-content:space-between;align-items:center;color:#374151;font-size:26rpx}.chart-head text:last-child{color:#9ca3af;font-size:23rpx}.chart-wrap{height:400rpx;display:flex;align-items:center;justify-content:center}.chart{width:100%;height:370rpx}.empty-state{padding:12rpx 0 20rpx}.table-entry{display:flex;align-items:center;justify-content:space-between;margin-top:24rpx;padding:28rpx 24rpx;color:#07c160;font-size:28rpx}.table-entry-arrow{font-size:36rpx;line-height:1;color:#999}
