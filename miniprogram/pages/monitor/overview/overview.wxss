.page{min-height:100vh;padding:24rpx;background:#f5f7f8;box-sizing:border-box}
.state{text-align:center;padding:120rpx 24rpx;color:#999;font-size:28rpx}
.error{color:#d14343}
.retry{color:#07c160}

/* 环形占比图卡片 */
.donut-card{background:#fff;border-radius:12rpx;box-shadow:0 2rpx 12rpx rgba(0,0,0,.04);padding:28rpx 24rpx 20rpx;margin-bottom:24rpx}
.donut-title{text-align:center;font-size:28rpx;color:#374151;margin-bottom:8rpx}
.donut-wrap{display:flex;align-items:center;justify-content:center;height:420rpx}
.donut-canvas{width:400rpx;height:400rpx}
.donut-rate-summary{text-align:center;color:#6b7280;font-size:26rpx;margin:-22rpx 0 16rpx}
.donut-rate-summary text{color:#16a34a;font-size:42rpx;font-weight:600}
.donut-legend{display:flex;justify-content:center;gap:32rpx;padding-top:8rpx}
.legend-item{display:flex;align-items:center;font-size:23rpx;color:#6b7280}
.legend-dot{width:16rpx;height:16rpx;border-radius:50%;margin-right:8rpx}
.legend-dot.normal{background:#16a34a}
.legend-dot.fault{background:#ef4444}
.legend-dot.repairing{background:#f59e0b}

/* 柱状图卡片 */
.chart-card,.table-entry{background:#fff;border-radius:12rpx;box-shadow:0 2rpx 12rpx rgba(0,0,0,.04)}
.chart-card{padding:24rpx}
.chart-head{display:flex;justify-content:space-between;align-items:center;color:#374151;font-size:26rpx}
.chart-head text:last-child{color:#9ca3af;font-size:23rpx}
.chart-wrap{height:400rpx;display:flex;align-items:center;justify-content:center}
.chart{width:100%;height:370rpx}
.empty-state{padding:12rpx 0 20rpx}

/* 表格入口 */
.table-entry{display:flex;align-items:center;justify-content:space-between;margin-top:24rpx;padding:28rpx 24rpx;color:#07c160;font-size:28rpx}
.table-entry-arrow{font-size:36rpx;line-height:1;color:#999}
