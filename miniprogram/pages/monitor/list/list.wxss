.page{padding:24rpx;background:#f5f7f8;min-height:100vh;box-sizing:border-box}.search{background:#fff;border-radius:12rpx;padding:4rpx 20rpx}.search input{height:72rpx;font-size:28rpx}.filters{white-space:nowrap;margin:20rpx 0}.filter{display:inline-block;padding:14rpx 28rpx;margin-right:16rpx;background:#fff;border-radius:32rpx;color:#666;font-size:26rpx}.filter.active{background:#07c160;color:#fff}.state,.more-state{text-align:center;padding:100rpx 24rpx;color:#999;font-size:28rpx}.more-state{padding:24rpx}.error{color:#d14343}.retry{color:#07c160}.monitor{background:#fff;border-radius:12rpx;padding:26rpx 24rpx;margin-bottom:18rpx}.monitor-head{display:flex;justify-content:space-between;align-items:center}.name{font-size:32rpx;font-weight:600;color:#222}.tag{font-size:23rpx;border:1px solid;padding:5rpx 14rpx;border-radius:24rpx}.meta{color:#888;font-size:25rpx;margin-top:12rpx}.summary{display:flex;justify-content:space-between;color:#666;font-size:23rpx;margin-top:22rpx;border-top:1rpx solid #f0f0f0;padding-top:18rpx}
