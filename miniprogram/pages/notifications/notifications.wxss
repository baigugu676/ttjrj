/* 消息通知页样式 */
.page {
  min-height: 100vh;
  background: #F5F5F5;
  padding-bottom: 120rpx;
}

.list {
  padding: 20rpx;
}

.notif-item {
  display: flex;
  align-items: center;
  padding: 24rpx 20rpx;
  background: #FFFFFF;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
  position: relative;
}

.notif-item.unread {
  background: #F0F9FF;
  border-left: 6rpx solid #07C160;
}

.notif-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #FA5151;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.notif-body {
  flex: 1;
  overflow: hidden;
}

.notif-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
  margin-bottom: 8rpx;
}

.notif-content {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.notif-time {
  font-size: 22rpx;
  color: #999999;
  margin-top: 10rpx;
}

.notif-arrow {
  font-size: 36rpx;
  color: #CCCCCC;
  margin-left: 12rpx;
  flex-shrink: 0;
}

.empty {
  text-align: center;
  padding: 120rpx 0;
  color: #999999;
  font-size: 28rpx;
}

.load-more {
  text-align: center;
  padding: 30rpx 0;
  color: #CCCCCC;
  font-size: 24rpx;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 40rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  border-top: 1rpx solid #EEEEEE;
}

.bottom-bar .btn {
  width: 100%;
}
