/* 报修详情页样式 */
.head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}
.order-no {
  font-size: 24rpx;
  color: #999999;
}
.info-row {
  display: flex;
  margin-bottom: 16rpx;
  line-height: 1.6;
}
.info-row .label {
  width: 140rpx;
  flex-shrink: 0;
  color: #999999;
  font-size: 26rpx;
}
.info-row .value {
  flex: 1;
  font-size: 26rpx;
  color: #333333;
  word-break: break-all;
}
/* 驳回提醒横幅：红色醒目展示，避免报修用户忽略 */
.reject-banner {
  margin: 20rpx 24rpx;
  padding: 28rpx;
  background: #FFF1F0;
  border: 2rpx solid #FA5151;
  border-radius: 16rpx;
}
.reject-banner-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #FA5151;
  margin-bottom: 12rpx;
}
.reject-banner-reason {
  font-size: 28rpx;
  color: #333333;
  line-height: 1.6;
  word-break: break-all;
  margin-bottom: 8rpx;
}
.reject-banner-time {
  font-size: 24rpx;
  color: #999999;
}

.photo-grid {
  display: flex;
  flex-wrap: wrap;
}
.photo {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  margin: 0 16rpx 16rpx 0;
}
