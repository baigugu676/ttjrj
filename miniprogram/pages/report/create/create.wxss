/* 新建报修页样式 */
.form-card {
  margin-top: 24rpx;
}
.location-search {
  height: 76rpx;
  box-sizing: border-box;
  width: 100%;
  margin: 12rpx 0;
  padding: 0 22rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 8rpx;
  background: #f8fafc;
  color: #333;
  font-size: 28rpx;
}
.field-hint { color:#d97706; font-size:24rpx; margin:8rpx 0 12rpx; }
.char-count { text-align:right; color:#9ca3af; font-size:22rpx; margin-top:8rpx; }
.upload-progress { text-align:center; color:#64748b; font-size:23rpx; margin-top:16rpx; }
.upload-tip {
  font-size: 24rpx;
  color: #07C160;
  margin-top: 8rpx;
}
.submit-area {
  padding: 32rpx 48rpx;
}
.submit-btn {
  width: 100%;
}
