/* 报修列表页样式 */
.filter-tabs {
  display: flex;
  background: #FFFFFF;
  padding: 20rpx 8rpx;
  position: sticky;
  top: 0;
  z-index: 10;
}
.filter-tab {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: #666666;
  padding: 10rpx 0;
  border-radius: 30rpx;
  margin: 0 6rpx;
}
.filter-tab.active {
  background: rgba(7, 193, 96, 0.12);
  color: #07C160;
  font-weight: 600;
}
.list {
  padding: 20rpx 24rpx 40rpx;
}
.load-more {
  text-align: center;
  font-size: 24rpx;
  color: #999999;
  padding: 20rpx 0;
}
