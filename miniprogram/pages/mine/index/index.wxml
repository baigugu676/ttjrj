<!-- 我的：个人信息 + 按角色显示功能菜单 + 退出登录 -->
<view class="page">
  <!-- 个人信息 -->
  <view class="profile">
    <image class="avatar" wx:if="{{userInfo.avatar_url || userInfo.avatar}}" src="{{userInfo.avatar_url || userInfo.avatar}}" mode="aspectFill"></image>
    <view class="avatar default" wx:else>{{initial}}</view>
    <view class="profile-info">
      <view class="name">{{userInfo.real_name || userInfo.username || '用户'}}</view>
      <view class="role-tag">{{roleText}}</view>
    </view>
  </view>

  <!-- 功能菜单（按角色） -->
  <view class="card menu">
    <!-- 公共：消息通知 -->
    <view class="menu-item" bindtap="goPage" data-url="/pages/notifications/notifications">
      <text class="menu-icon">🔔</text>
      <text class="menu-text">消息通知</text>
      <view class="badge-row">
        <view class="badge" wx:if="{{unreadCount}}">{{unreadCount > 99 ? '99+' : unreadCount}}</view>
      </view>
      <text class="arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goPage" data-url="/pages/monitor/overview/overview">
      <text class="menu-icon">📊</text>
      <text class="menu-text">监控状态概览</text>
      <text class="arrow">›</text>
    </view>

    <!-- 报修用户 -->
    <block wx:if="{{role === 'user'}}">
      <view class="menu-item" bindtap="goPage" data-url="/pages/report/list/list">
        <text class="menu-icon">📋</text>
        <text class="menu-text">我的报修</text>
        <text class="arrow">›</text>
      </view>
      <view class="menu-item" bindtap="goPage" data-url="/pages/report/create/create">
        <text class="menu-icon">➕</text>
        <text class="menu-text">新建报修</text>
        <text class="arrow">›</text>
      </view>
    </block>

    <!-- 维修人员 -->
    <block wx:elif="{{role === 'repairer'}}">
      <view class="menu-item" bindtap="goPage" data-url="/pages/report/create/create">
        <text class="menu-icon">➕</text>
        <text class="menu-text">上报故障（免审核）</text>
        <text class="arrow">›</text>
      </view>
      <view class="menu-item" bindtap="goPage" data-url="/pages/repair/mytasks/mytasks">
        <text class="menu-icon">🔧</text>
        <text class="menu-text">维修记录</text>
        <text class="arrow">›</text>
      </view>
      <view class="menu-item" bindtap="goPage" data-url="/pages/repair/pool/pool">
        <text class="menu-icon">🗂️</text>
        <text class="menu-text">待接单工单池</text>
        <text class="arrow">›</text>
      </view>
    </block>

    <!-- 管理员 -->
    <block wx:else>
      <view class="menu-item" bindtap="goPage" data-url="/pages/report/create/create">
        <text class="menu-icon">➕</text>
        <text class="menu-text">新建报修（免审核）</text>
        <text class="arrow">›</text>
      </view>
      <view class="menu-item" bindtap="goPage" data-url="/pages/admin/orders/orders">
        <text class="menu-icon">🗂️</text>
        <text class="menu-text">工单管理</text>
        <text class="arrow">›</text>
      </view>
      <view class="menu-item" bindtap="goPage" data-url="/pages/admin/users/users">
        <text class="menu-icon">👥</text>
        <text class="menu-text">用户管理</text>
        <text class="arrow">›</text>
      </view>
      <view class="menu-item" bindtap="goPage" data-url="/pages/admin/locations/locations">
        <text class="menu-icon">📍</text>
        <text class="menu-text">点位管理</text>
        <text class="arrow">›</text>
      </view>
      <view class="menu-item" bindtap="goPage" data-url="/pages/admin/statistics/statistics">
        <text class="menu-icon">📊</text>
        <text class="menu-text">数据统计</text>
        <text class="arrow">›</text>
      </view>
    </block>
  </view>

  <!-- 退出登录 -->
  <button class="btn btn-danger logout-btn" bindtap="onLogout">退出登录</button>

  <view class="version">设备报修维修系统 v1.0.0</view>
</view>
