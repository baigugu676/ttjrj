/* 登录页样式：居中布局 */
.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #07C160 0%, #FFFFFF 40%);
  box-sizing: border-box;
  padding: 0 48rpx 80rpx;
}

.header {
  padding: 140rpx 0 80rpx;
  text-align: center;
}
.logo {
  width: 160rpx;
  height: 160rpx;
  line-height: 160rpx;
  margin: 0 auto 32rpx;
  background: #FFFFFF;
  border-radius: 40rpx;
  font-size: 80rpx;
  box-shadow: 0 8rpx 30rpx rgba(7, 193, 96, 0.25);
}
.app-name {
  font-size: 44rpx;
  font-weight: 600;
  color: #FFFFFF;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}
.app-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 12rpx;
}

.form-card {
  padding: 40rpx 32rpx;
}
.login-btn {
  width: 100%;
  margin-top: 16rpx;
}

.divider {
  display: flex;
  align-items: center;
  margin: 40rpx 0 32rpx;
}
.divider-line {
  flex: 1;
  height: 1rpx;
  background: #E5E5E5;
}
.divider-text {
  font-size: 24rpx;
  color: #999999;
  margin: 0 20rpx;
}

.wx-btn {
  background: #07C160;
  color: #FFFFFF;
  width: 100%;
}

